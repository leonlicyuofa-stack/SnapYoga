# Copy to `.env.local` in the project root (same folder as package.json).
# Values: Firebase Console → Project settings → Your apps → Web app → firebaseConfig.
# Restart `npm run dev` after creating or editing `.env.local`.
#
# Cloud Run pose API — set the origin only (recommended):
# ANALYSIS_SERVICE_URL=https://gcloud-yoga-pose-test-526785842170.asia-east2.run.app
# Optional path override (default: /v2/analyze-video-vision):
# ANALYSIS_SERVICE_PATH=/v2/analyze-video-vision
# List routes: {ANALYSIS_SERVICE_URL}/openapi.json

# GCP service account for Vercel (Cloud Run auth + Firebase Admin uploads).
# Required on Vercel for Production and Preview. Local dev can use ADC instead.
# Grant the SA: roles/run.invoker on Cloud Run, Storage Object Admin, Firestore access.
#
# Option A — full JSON key (paste the ENTIRE key.json file as ONE line):
# GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
#
# Do NOT paste only project_id or client_email here — it must be the full JSON object.
# If JSON parsing fails, delete this var and use Option B instead.
#
# Aliases also accepted: GOOGLE_SERVICE_ACCOUNT_JSON, FIREBASE_SERVICE_ACCOUNT_KEY
#
# Option B — split fields (often easier in Vercel; recommended if JSON keeps failing):
# GCP_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# GCP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# project_id is inferred from the service account email (@your-project.iam...).
# Optional server-side override (read at runtime, not build time):
# FIREBASE_PROJECT_ID=snapyoga

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Genkit / Gemini (feedback summarization, reflection themes)
# GEMINI_API_KEY=
