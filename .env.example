# Copy to `.env.local` in the project root (same folder as package.json).
# Values: Firebase Console → Project settings → Your apps → Web app → firebaseConfig.
# Restart `npm run dev` after creating or editing `.env.local`.
#
# Cloud Run pose API — set the origin (https://xxx.run.app) or full path.
# The app POSTs to /v2/analyze-video-vision when only the origin is given.

# ANALYSIS_SERVICE_URL=https://your-service.asia-east2.run.app

# GCP service account for Vercel (Cloud Run auth + Firebase Admin uploads).
# Required on Vercel; local dev can use `gcloud auth application-default login` instead.
# Grant the SA: roles/run.invoker on Cloud Run, and Storage Object Admin + Firestore access.
#
# Option A — full JSON key (single line):
# GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
#
# Option B — split fields:
# GCP_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# GCP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Genkit / Gemini (feedback summarization, reflection themes)
# GEMINI_API_KEY=
