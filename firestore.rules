
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access to prevent unintended access.
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !('subscriptionStatus' in request.resource.data)
                    && !('subscriptionPlan' in request.resource.data)
                    && !('stripeCustomerId' in request.resource.data)
                    && !('stripeSessionId' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['subscriptionStatus', 'subscriptionPlan', 'stripeCustomerId',
                                 'stripeSessionId', 'subscriptionStartDate', 'membershipTier']);
    }

    // Pose Analyses subcollection
    match /users/{userId}/poseAnalyses/{analysisId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Raw API logs written by the server action (Admin SDK); users can read their own.
    match /users/{userId}/poseAnalysisRawLogs/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    
    // Moods subcollection
    match /users/{userId}/moods/{moodId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Habits subcollection
    match /users/{userId}/habits/{dayId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Journal subcollection
    match /users/{userId}/journal/{dayId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily Logins / Activity subcollection
    match /users/{userId}/activity/{dayId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Challenge Tasks subcollection
    match /users/{userId}/challengeTasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Invitations collection
    match /invitations/{invitationId} {
      allow create: if request.auth != null
                      && request.resource.data.inviterUid == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;

      allow read: if request.auth != null
                    && (request.auth.uid == resource.data.inviterUid || request.auth.uid == resource.data.inviteeUid);

      allow update: if request.auth != null && request.auth.uid == resource.data.inviteeUid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                      && request.resource.data.status != resource.data.status
                      && request.resource.data.updatedAt == request.time;
    }
  }
}
